<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CIDE.Views"
        xmlns:vm="clr-namespace:CIDE.PageModels"
        x:DataType="vm:MainPageModel"
        x:Class="CIDE.MainWindow"
        Title="CIDE"
        Icon="avares://CIDE/Assets/cide_logo.png"
        Width="1200" Height="900"
        Background="{DynamicResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1">

    <!-- Важно: убрали класс windowFlyIn отсюда, чтобы не ломать границы окна -->
    <Grid x:Name="JellyContainer" RowDefinitions="Auto, *" Margin="0,35,0,0">

        <!-- Toolbar (Floating Island) -->
        <Border Grid.Row="0" IsVisible="{Binding IsWorkspaceOpen}" Classes="glowOnHover" Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Margin="8,8,8,4" Height="46" BoxShadow="0 4 15 0 #33000000">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Left: Tools -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Button Classes="subtle fluid" Command="{Binding GoBackCommand}" ToolTip.Tip="Назад">
                        <TextBlock Text="⬅ Назад" FontSize="13"/>
                    </Button>
                    <Button Classes="subtle fluid" Content="⚙️ Настройки" FontSize="13" ToolTip.Tip="Настройки" Command="{Binding OpenSettingsCommand}"/>
                    <Button Classes="subtle fluid" Content="📊 Нагрузка сервера" FontSize="13" ToolTip.Tip="Диспетчер задач SSH" Command="{Binding ShowServerLoadCommand}" IsVisible="{Binding IsSshWorkspace}"/>
                    <Button Classes="subtle fluid" Content="🧹 Чистка кода" FontSize="13" ToolTip.Tip="Форматировать код" Command="{Binding FormatCodeCommand}"/>
                    <Button Classes="subtle fluid" Content="💬 Убрать комменты" FontSize="13" ToolTip.Tip="Удалить комментарии" Command="{Binding RemoveCommentsCommand}"/>
                </StackPanel>

                <!-- Right: Build Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWorkspaceOpen}" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Classes="subtle fluid" Command="{Binding RunCommandCommand}" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="▶" Foreground="#4CAF50" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Run" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <!-- НОВАЯ КНОПКА STOP -->
                    <Button Classes="subtle fluid" Command="{Binding StopCommandCommand}" Margin="0,0,10,0" ToolTip.Tip="Принудительно остановить процесс">
                        <TextBlock Text="⏹" Foreground="#FF5555" FontSize="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button Classes="subtle fluid" Command="{Binding ToggleOutputCommand}" Padding="12,4" MinHeight="28" CornerRadius="4">
                        <TextBlock Text="Terminal" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <TransitioningContentControl>
                <TransitioningContentControl.PageTransition>
                    <!-- Плавный переход в 300мс -->
                    <CrossFade Duration="0:0:0.3" />
                </TransitioningContentControl.PageTransition>
                
                <TransitioningContentControl.Content>
                    <Panel>
                        <!-- Splash Screen -->
                        <views:SplashView IsVisible="{Binding IsLoadingState}" />

                        <!-- Welcome Screen -->
                        <views:WelcomeView IsVisible="{Binding IsWelcomeState}" />

                        <!-- IDE Workspace -->
                        <Grid IsVisible="{Binding IsWorkspaceOpen}" RowDefinitions="*, 24">
                            <!-- Main Area -->

                <!-- ИСПРАВЛЕНО: Задаем стартовую ширину колонки 250px для сайдбара и 8px для сплиттера -->
                <Grid x:Name="MainAreaGrid" Grid.Row="0" Margin="8,4,8,8" ColumnDefinitions="250, 8, *">

                    <!-- САЙДБАР: Убрана жесткая ширина (Width="250") -->
                    <Border x:Name="SidebarPanel" Grid.Column="0" Background="Transparent" BorderThickness="0" ClipToBounds="True">
                        <views:SidebarView />
                    </Border>

                    <!-- СПЛИТТЕР: Добавлено правильное растягивание и курсор -->
                    <GridSplitter Grid.Column="1"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  HorizontalAlignment="Stretch"
                                  Cursor="SizeWestEast"/>

                    <!-- РЕДАКТОР -->
                    <Grid x:Name="EditorPanel" Grid.Column="2" RowDefinitions="*, 0, 0">
                        <!-- Редактор кода -->
                        <views:EditorView x:Name="EditorViewControl" Grid.Row="0" />

                        <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows" Height="8"/>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource BgSurface}" ClipToBounds="True" Classes="windowFlyIn glowOnHover glowOnFocus">
                            <Grid>
                                <TabControl x:Name="OutputTabControl" Margin="0" Background="Transparent" Padding="0">
                                    <TabItem Header="Терминал" FontSize="12">
                                        <views:TerminalView x:Name="MainTerminalView" Margin="0,4,0,0" />
                                    </TabItem>
                                    <TabItem Header="Вывод" FontSize="12">
                                        <ScrollViewer x:Name="OutputScrollViewer" Margin="4" Padding="8">
                                            <SelectableTextBlock FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" Foreground="{DynamicResource FgPrimary}" TextWrapping="Wrap" Text="{Binding CompilerOutput}"/>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Список ошибок" FontSize="12">
                                        <ListBox ItemsSource="{Binding CompilerErrors}" Background="Transparent" Foreground="{DynamicResource FgPrimary}" Margin="4" BorderThickness="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Color}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </TabItem>
                                </TabControl>

                                <!-- Smart Terminal Controls (Overlaid on top right) -->
                                <StackPanel x:Name="TerminalControlsPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0" Spacing="4">
                                    <ComboBox x:Name="ProfileComboBox" MinWidth="120" MaxHeight="24" FontSize="11" VerticalAlignment="Center" Background="{DynamicResource BgInput}" Foreground="{DynamicResource FgPrimary}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,0">
                                        <ComboBoxItem>PowerShell</ComboBoxItem>
                                        <ComboBoxItem>CMD</ComboBoxItem>
                                        <ComboBoxItem>WSL</ComboBoxItem>
                                    </ComboBox>
                                    <Button x:Name="NewTermBtn" Content="＋" Classes="subtle" Foreground="{DynamicResource FgSecondary}" Padding="6,0" Height="24" FontSize="13" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Новый терминал" />
                                    <Button x:Name="ClearBtn" Content="🗑" Classes="subtle" Foreground="{DynamicResource FgSecondary}" Padding="6,0" Height="24" FontSize="13" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Очистить" />
                                    <Button x:Name="HideTerminalBtn" Content="✕" Classes="subtle" Foreground="{DynamicResource FgSecondary}" Padding="6,0" Height="24" FontSize="13" VerticalAlignment="Center" Cursor="Hand" ToolTip.Tip="Свернуть панель" Command="{Binding ToggleOutputCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <!-- Оверлей загрузки (Glassmorphism) -->
                        <Border Grid.RowSpan="3" Background="#99000000" IsVisible="{Binding IsBusy}" ZIndex="100">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#9061F9" Background="#339061F9" />
                                <TextBlock Text="{Binding BusyText}" FontSize="16" Foreground="White" FontWeight="Medium" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="1" Background="{Binding RemoteStatusColor}" CornerRadius="0">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto" Margin="14,0">
                        
                        <!-- Левая кнопка статуса (Локально / WSL / SSH) -->
                        <!-- Мы используем Margin="0", а цвет берем из модели, но чуть темнее -->
                        <Border Grid.Column="0" Background="#33000000" CornerRadius="2" Padding="8,2" VerticalAlignment="Center" Margin="0,2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="&gt;&lt;" Foreground="White" FontSize="10" FontWeight="Bold" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding RemoteStatusText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        
                        <!-- Выбранный профиль -->
                        <Border Grid.Column="1" Background="#33000000" CornerRadius="2" Padding="6,2" VerticalAlignment="Center" Margin="8,2">
                            <TextBlock Text="{Binding SelectedBuildProfile}" Foreground="White" FontSize="10" FontWeight="Bold" />
                        </Border>

                        <TextBlock Grid.Column="2" Text="{Binding StatusText}" Foreground="White" Opacity="0.9" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
                        
                        <TextBlock Grid.Column="3" Text="{Binding CursorPosition}" Foreground="#E0D4FC" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="4" Text="LF | UTF-8" Foreground="#E0D4FC" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="5" Text="CIDE Avalonia v2.0" Foreground="#E0D4FC" FontSize="11" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
                    </Panel>
                </TransitioningContentControl.Content>
            </TransitioningContentControl>
        </Grid>
    </Grid>
</Window>
