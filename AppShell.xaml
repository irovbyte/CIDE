<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CIDE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:CIDE.Pages"
    x:ClassModifier="internal"
    FlyoutBackgroundColor="#0D0B18"
    FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False">

    <Shell.Resources>
        <Style TargetType="FlyoutItem">
            <Setter Property="Shell.ItemTemplate">
                <DataTemplate>
                    <Grid Padding="16,0" HeightRequest="44">
                        <Label
                            FontSize="13"
                            Text="{Binding Title}"
                            TextColor="#7A7290"
                            VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </Setter>
        </Style>
    </Shell.Resources>

    <FlyoutItem Title="⌂  Стартовый экран">
        <ShellContent ContentTemplate="{DataTemplate pages:WelcomePage}" Route="WelcomePage" />
    </FlyoutItem>

    <ShellContent
        ContentTemplate="{DataTemplate pages:MainPage}"
        FlyoutItemIsVisible="False"
        Route="MainPage" />

    <FlyoutItem Title="⚙  Настройки">
        <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="SettingsPage" />
    </FlyoutItem>

</Shell>
