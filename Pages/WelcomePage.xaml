<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CIDE.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CIDE.Helpers"
    xmlns:m="clr-namespace:CIDE.Models"
    xmlns:pm="clr-namespace:CIDE.PageModels"
    x:Name="Root"
    x:ClassModifier="internal"
    Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="300, *">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#090714" />
                <GradientStop Offset="0.5" Color="#141226" />
                <GradientStop Offset="1.0" Color="#0D0B1A" />
            </LinearGradientBrush>
        </Grid.Background>

        <Border
            Grid.Column="0"
            BackgroundColor="#80090714"
            Stroke="#2D2B44"
            StrokeThickness="1">
            <VerticalStackLayout>
                <Label
                    Margin="25,30,0,10"
                    FontAttributes="Bold"
                    FontSize="44"
                    Text="CIDE"
                    TextColor="#C586C0" />
                <Label
                    Margin="25,0,0,10"
                    FontSize="12"
                    Text="C/C++/C# Smart IDE"
                    TextColor="Gray" />
                <Label
                    Margin="25,0,0,10"
                    FontSize="10"
                    Text="{Binding ToolchainStatus}"
                    TextColor="#4EC9B0" />
                <BoxView
                    Margin="20,10"
                    HeightRequest="1"
                    Color="#2D2B44" />
                <Label
                    Margin="25,0,0,10"
                    FontSize="11"
                    Text="НЕДАВНИЕ ПРОЕКТЫ"
                    TextColor="Gray" />

                <CollectionView ItemsSource="{Binding Recents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:RecentEntry">
                            <Grid Padding="20,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenRecentCommand}" CommandParameter="{Binding}" />
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="30, *">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="16"
                                        Text="&#xE8B7;"
                                        TextColor="#E8C56D"
                                        VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label
                                            FontSize="14"
                                            Text="{Binding Name}"
                                            TextColor="White" />
                                        <Label
                                            FontSize="10"
                                            LineBreakMode="HeadTruncation"
                                            Text="{Binding Path}"
                                            TextColor="Gray" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout
            Grid.Column="1"
            Spacing="40"
            VerticalOptions="Center">
            <Label
                FontAttributes="Bold"
                FontSize="32"
                HorizontalOptions="Center"
                Text="Начало работы"
                TextColor="White" />
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="25">
                <Border
                    x:Name="CardFolder"
                    Padding="0"
                    Background="#601A182A"
                    HeightRequest="200"
                    Stroke="#4EC9B0"
                    StrokeThickness="2"
                    WidthRequest="220">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenFolderCommand}" Tapped="OnCardFolderTappedAsync" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="15" VerticalOptions="Center">
                        <Label
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            HorizontalOptions="Center"
                            Text="&#xE8E5;"
                            TextColor="#4EC9B0" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Открыть папку"
                            TextColor="White" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="Любой C/C++ проект"
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="CardSolution"
                    Padding="0"
                    Background="#601A182A"
                    HeightRequest="200"
                    Stroke="#C586C0"
                    StrokeThickness="2"
                    WidthRequest="220">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSolutionCommand}" Tapped="OnCardSolutionTappedAsync" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="15" VerticalOptions="Center">
                        <Label
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="48"
                            HorizontalOptions="Center"
                            Text="&#xE71B;"
                            TextColor="#C586C0" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalOptions="Center"
                            Text="Открыть решение"
                            TextColor="White" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text=".slnx для C# проектов"
                            TextColor="Gray" />
                    </VerticalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
