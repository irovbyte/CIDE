<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:CIDE.PageModels"
             xmlns:m="clr-namespace:CIDE.Models"
             xmlns:helpers="clr-namespace:CIDE.Helpers"
             x:Class="CIDE.Pages.WelcomePage"
             x:ClassModifier="internal"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="300, *">
        <!-- Сайдбар недавних -->
        <Border Grid.Column="0" BackgroundColor="{StaticResource BgSecondary}" StrokeThickness="0,0,1,0" Stroke="{StaticResource BorderColor}">
            <VerticalStackLayout>
                <Label Text="CIDE" FontSize="44" FontAttributes="Bold" TextColor="{StaticResource Accent}" Margin="25,30,0,10"/>
                <Label Text="C/C++/C# Smart IDE" FontSize="12" TextColor="{StaticResource TextSecondary}" Margin="25,0,0,10"/>
                <BoxView HeightRequest="1" Color="{StaticResource BorderColor}" Margin="20,10"/>
                <Label Text="НЕДАВНИЕ ПРОЕКТЫ" FontSize="11" TextColor="{StaticResource TextSecondary}" Margin="25,0,0,10"/>

                <CollectionView ItemsSource="{Binding Recents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:RecentEntry">
                            <Grid Padding="20,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenRecentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}"/>
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="30, *">
                                    <Label Grid.Column="0" Text="{Binding Icon}" TextColor="#E8C56D" FontSize="16" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Name}" TextColor="{StaticResource TextPrimary}" FontSize="14"/>
                                        <Label Text="{Binding Path}" TextColor="{StaticResource TextSecondary}" FontSize="10" LineBreakMode="HeadTruncation"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Карточки действий -->
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="40">
            <Label Text="Начало работы" FontSize="32" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center"/>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="25">

                <Frame BackgroundColor="{StaticResource BgSecondary}" BorderColor="{StaticResource BorderColor}" CornerRadius="12" WidthRequest="220" HeightRequest="200">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenFolderCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Label Text="📂" FontSize="50" HorizontalOptions="Center"/>
                        <Label Text="Открыть папку" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Любой C/C++ проект" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="{StaticResource BgSecondary}" BorderColor="{StaticResource BorderColor}" CornerRadius="12" WidthRequest="220" HeightRequest="200">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSolutionCommand}"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Label Text="⬡" FontSize="50" TextColor="#C586C0" HorizontalOptions="Center"/>
                        <Label Text="Открыть решение" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text=".slnx для C# проектов" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
