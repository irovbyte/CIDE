<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pm="clr-namespace:CIDE.PageModels"
             xmlns:m="clr-namespace:CIDE.Models"
             xmlns:helpers="clr-namespace:CIDE.Helpers"
             x:Class="CIDE.Pages.WelcomePage"
             x:ClassModifier="internal"
             Shell.NavBarIsVisible="False">

    <Grid ColumnDefinitions="300, *">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#090714" Offset="0.0"/>
                <GradientStop Color="#141226" Offset="0.5"/>
                <GradientStop Color="#0D0B1A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Сайдбар недавних -->
        <Border Grid.Column="0" BackgroundColor="#80090714" StrokeThickness="1" Stroke="#2D2B44">
            <VerticalStackLayout>
                <Label Text="CIDE" FontSize="44" FontAttributes="Bold" TextColor="#C586C0" Margin="25,30,0,10"/>
                <Label Text="C/C++/C# Smart IDE" FontSize="12" TextColor="Gray" Margin="25,0,0,10"/>
                <Label Text="{Binding ToolchainStatus}" FontSize="10" TextColor="#4EC9B0" Margin="25,0,0,10" />
                <BoxView HeightRequest="1" Color="#2D2B44" Margin="20,10"/>
                <Label Text="НЕДАВНИЕ ПРОЕКТЫ" FontSize="11" TextColor="Gray" Margin="25,0,0,10"/>

                <CollectionView ItemsSource="{Binding Recents}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:RecentEntry">
                            <Grid Padding="20,10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BindingContext.OpenRecentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" CommandParameter="{Binding}"/>
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="30, *">
                                    <Label Grid.Column="0" Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" TextColor="#E8C56D" FontSize="16" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Name}" TextColor="White" FontSize="14"/>
                                        <Label Text="{Binding Path}" TextColor="Gray" FontSize="10" LineBreakMode="HeadTruncation"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- Карточки действий -->
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="40">
            <Label Text="Начало работы" FontSize="32" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="25">
                <Border x:Name="CardFolder" Background="#601A182A" 
        Stroke="#4EC9B0" 
        StrokeThickness="2" 
        WidthRequest="220" 
        HeightRequest="200" 
        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardFolderTappedAsync" Command="{Binding OpenFolderCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Label Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="48" TextColor="#4EC9B0" HorizontalOptions="Center"/>
                        <Label Text="Открыть папку" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Любой C/C++ проект" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="CardSolution" Background="#601A182A" 
        Stroke="#C586C0" 
        StrokeThickness="2" 
        WidthRequest="220" 
        HeightRequest="200" 
        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCardSolutionTappedAsync" Command="{Binding OpenSolutionCommand}"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="15">
                        <Label Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="48" TextColor="#C586C0" HorizontalOptions="Center"/>
                        <Label Text="Открыть решение" TextColor="White" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text=".slnx для C# проектов" FontSize="12" TextColor="Gray" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
