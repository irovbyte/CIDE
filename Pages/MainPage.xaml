<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CIDE.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:CIDE.Helpers"
    xmlns:views="clr-namespace:CIDE.Views"
    x:ClassModifier="internal"
    BackgroundColor="#06040A"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <helpers:DepthToMarginConverter x:Key="DepthConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="50, *, 24">

        <views:ToolbarView x:Name="ToolbarPanel" Grid.Row="0" />

        <Grid
            Grid.Row="1"
            Margin="8,8,8,4"
            ColumnDefinitions="250, 1, *">

            <views:SidebarView x:Name="SidebarPanel" Grid.Column="0" />

            <BoxView Grid.Column="1" Color="Transparent" />

            <Grid
                x:Name="EditorPanel"
                Grid.Column="2"
                Margin="6,0,0,0"
                RowDefinitions="*, Auto">

                <views:EditorView x:Name="EditorViewControl" Grid.Row="0" />

                <views:TerminalView
                    x:Name="OutputPanel"
                    Grid.Row="1"
                    Margin="0,8,0,0" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            BackgroundColor="#0A0714"
            StrokeThickness="0">
            <Grid>
                <BoxView
                    HeightRequest="1"
                    VerticalOptions="Start"
                    Color="#1D153A" />
                <Grid
                    Padding="14,0"
                    ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto"
                    ColumnSpacing="16">

                    <Border
                        Grid.Column="0"
                        Margin="0,2"
                        Padding="8,1"
                        BackgroundColor="#7C3AED"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="4" />
                        </Border.StrokeShape>
                        <Label
                            FontAttributes="Bold"
                            FontSize="9,5"
                            Text="{Binding SelectedBuildProfile}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        Grid.Column="1"
                        FontSize="10"
                        Opacity="0.7"
                        Text="{Binding StatusText}"
                        TextColor="#ECE9FC"
                        VerticalOptions="Center" />

                    <HorizontalStackLayout
                        Grid.Column="3"
                        Spacing="6"
                        VerticalOptions="Center">
                        <Ellipse
                            x:Name="SshDot"
                            Fill="#4F477A"
                            HeightRequest="6"
                            WidthRequest="6" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="9,5"
                            Text="SSH STATUS"
                            TextColor="#9E96C4" />
                    </HorizontalStackLayout>

                    <Label
                        Grid.Column="4"
                        FontSize="10"
                        Text="LF · UTF-8"
                        TextColor="#4F477A"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="5"
                        FontSize="10"
                        Text="CIDE v1.0"
                        TextColor="#4F477A"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
