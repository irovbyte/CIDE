<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CIDE.Views.TerminalView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid
        BackgroundColor="#06040A"
        HeightRequest="200"
        IsVisible="{Binding IsOutputVisible}"
        RowDefinitions="32, *">

        <Border
            Grid.Row="0"
            BackgroundColor="#0A0714"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.Stroke>
                <SolidColorBrush Color="#1D153A" />
            </Border.Stroke>
            <Grid>
                <HorizontalStackLayout Padding="14,0" Spacing="22">
                    <Label
                        CharacterSpacing="1"
                        FontAttributes="Bold"
                        FontSize="10"
                        Text="ВЫВОД КОМПИЛЯЦИИ"
                        TextColor="#00F5FF"
                        VerticalOptions="Center" />
                    <Label
                        CharacterSpacing="1"
                        FontSize="10"
                        Text="ПРОБЛЕМЫ"
                        TextColor="#4F477A"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button
                    Padding="0"
                    Command="{Binding ToggleOutputCommand}"
                    HeightRequest="30"
                    HorizontalOptions="End"
                    Style="{StaticResource ToolbarButton}"
                    Text="✕"
                    TextColor="#FF2A85"
                    WidthRequest="30" />
                <BoxView
                    HeightRequest="1"
                    VerticalOptions="End"
                    Color="#1D153A" />
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            BackgroundColor="#07050C"
            StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Border.Stroke>
                <SolidColorBrush Color="#1D153A" />
            </Border.Stroke>
            <ScrollView Padding="14,10">
                <Label
                    FontFamily="Consolas"
                    FontSize="11,5"
                    LineBreakMode="CharacterWrap"
                    Text="{Binding CompilerOutput}"
                    TextColor="#00FFC2" />
            </ScrollView>
        </Border>
    </Grid>

</ContentView>
