<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:CIDE.Helpers"
        x:Class="CIDE.Views.CreateCppProjectDialog"
        Title="Создать проект C/C++"
        Width="550" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        SystemDecorations="None"
        ShowInTaskbar="False">

    <Window.Resources>
        <helpers:IconPathConverter x:Key="IconConverter"/>
    </Window.Resources>

    <Grid Classes="windowFlyIn">
        <!-- Main Glass Panel -->
        <Border Background="{DynamicResource BgSurface}" 
                BorderBrush="{DynamicResource BorderSubtle}" 
                BorderThickness="1" 
                CornerRadius="16" 
                Margin="20"
                BoxShadow="0 20 50 0 #40000000">

            <Grid RowDefinitions="Auto, *, Auto">
                
                <!-- Custom Draggable TitleBar -->
                <Border x:Name="TitleBarBorder" Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0">
                    <Grid Margin="20,15,20,10">
                        <TextBlock Text="Новый проект C/C++" FontSize="20" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#9C27B0"/>
                                    <GradientStop Offset="1" Color="#E040FB"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Content -->
                <Border Grid.Row="1" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Margin="20,0,20,20" Padding="20">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Язык" Foreground="{DynamicResource FgSecondary}" FontSize="13"/>
                            <ComboBox x:Name="LanguageComboBox" SelectedIndex="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem>C</ComboBoxItem>
                                <ComboBoxItem>C++</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Имя проекта" Foreground="{DynamicResource FgSecondary}" FontSize="13"/>
                            <TextBox x:Name="ProjectNameTextBox" Text="MyCppApp"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Расположение" Foreground="{DynamicResource FgSecondary}" FontSize="13"/>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBox x:Name="ProjectPathTextBox" Grid.Column="0" Margin="0,0,5,0"/>
                                <Button x:Name="BrowseButton" Grid.Column="1" Classes="subtle" Width="36" Height="36" Padding="8">
                                    <Image Source="{Binding Source='avares://CIDE/Assets/Icons/folders/default.svg', Converter={StaticResource IconConverter}}" Width="16" Height="16"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer Buttons -->
                <Border Grid.Row="2" Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,15" CornerRadius="0,0,16,16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="CancelButton" Classes="ghost" Content="Отмена" Width="100" HorizontalContentAlignment="Center"/>
                        <Button x:Name="CreateButton" Classes="accent" Content="Создать" Width="120" HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
