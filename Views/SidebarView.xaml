<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CIDE.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:m="clr-namespace:CIDE.Models">

    <Border BackgroundColor="#0A0714" StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Border.Stroke>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#2D1A54" />
                <GradientStop Offset="1" Color="#120A28" />
            </LinearGradientBrush>
        </Border.Stroke>

        <Grid RowDefinitions="36, *">

            <Grid
                Grid.Row="0"
                Padding="14,0"
                BackgroundColor="#0C081A">
                <Label
                    CharacterSpacing="2"
                    FontAttributes="Bold"
                    FontSize="10"
                    Text="{Binding ExplorerTitle}"
                    TextColor="#00F5FF"
                    VerticalOptions="Center" />
                <BoxView
                    HeightRequest="1"
                    VerticalOptions="End"
                    Color="#1D153A" />
            </Grid>

            <CollectionView
                x:Name="FileTree"
                Grid.Row="1"
                Margin="0,4"
                ItemsSource="{Binding FlatTree}"
                SelectionChanged="OnTreeSelectionChangedAsync"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:FileNode">
                        <Grid
                            Margin="{Binding Depth, Converter={StaticResource DepthConverter}}"
                            Padding="10,6"
                            ColumnDefinitions="14, 20, *">
                            
                            <Label
                                Grid.Column="0"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="9"
                                HorizontalOptions="Center"
                                Text="{Binding Glyph}"
                                TextColor="#9E96C4"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="13"
                                HorizontalOptions="Center"
                                Text="{Binding IconText}"
                                TextColor="{Binding IconColor}"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="2"
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Name}"
                                TextColor="#ECE9FC"
                                VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>

</ContentView>
