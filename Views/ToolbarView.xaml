<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="CIDE.Views.ToolbarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Margin="8,6,8,0"
        BackgroundColor="#0A0714"
        HeightRequest="38"
        StrokeThickness="1">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="10" />
        </Border.StrokeShape>
        <Border.Stroke>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#2D1A54" />
                <GradientStop Offset="1" Color="#120A28" />
            </LinearGradientBrush>
        </Border.Stroke>
        <Grid>
            <Grid
                Padding="10,0"
                ColumnDefinitions="Auto, Auto, *, Auto, Auto, Auto, Auto"
                ColumnSpacing="8">
                
                <Button
                    Grid.Column="0"
                    Command="{Binding GoBackCommand}"
                    FontSize="14"
                    Style="{StaticResource ToolbarButton}"
                    Text="⌂"
                    TextColor="#00F5FF"
                    ToolTipProperties.Text="На главную" />

                <BoxView
                    Grid.Column="1"
                    Margin="4,8"
                    WidthRequest="1"
                    Color="#1D153A" />

                <HorizontalStackLayout
                    Grid.Column="2"
                    Margin="6,0"
                    Spacing="8"
                    VerticalOptions="Center">
                    <CheckBox
                        HeightRequest="16"
                        IsChecked="{Binding IsAutoSaveEnabled}"
                        WidthRequest="16"
                        Color="#00F5FF" />
                    <Label
                        FontSize="11"
                        Opacity="0.8"
                        Text="Автосохранение"
                        TextColor="#ECE9FC"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="3"
                    Margin="4,0"
                    Spacing="6"
                    VerticalOptions="Center">
                    <Label
                        FontSize="11"
                        Text="Терминал:"
                        TextColor="#9E96C4"
                        VerticalOptions="Center" />
                    <Picker
                        BackgroundColor="#110C24"
                        FontSize="11"
                        ItemsSource="{Binding TerminalProfiles}"
                        SelectedItem="{Binding SelectedTerminalProfile}"
                        TextColor="#00F5FF"
                        WidthRequest="100" />
                </HorizontalStackLayout>

                <HorizontalStackLayout
                    Grid.Column="4"
                    Margin="4,0"
                    Spacing="8"
                    VerticalOptions="Center">
                    <Label
                        FontSize="11"
                        Text="Профиль:"
                        TextColor="#9E96C4"
                        VerticalOptions="Center" />
                    <Picker
                        BackgroundColor="#110C24"
                        FontSize="11"
                        ItemsSource="{Binding BuildProfiles}"
                        SelectedItem="{Binding SelectedBuildProfile}"
                        TextColor="#FF2A85"
                        WidthRequest="120" />
                    <Picker
                        BackgroundColor="#110C24"
                        FontSize="11"
                        ItemsSource="{Binding BuildTargets}"
                        SelectedItem="{Binding SelectedBuildTarget}"
                        TextColor="#ECE9FC"
                        WidthRequest="120" />
                </HorizontalStackLayout>

                <Button
                    x:Name="BtnBuild"
                    Grid.Column="5"
                    Command="{Binding BuildCommand}"
                    FontSize="12"
                    Style="{StaticResource ToolbarButton}"
                    Text="🛠 Сборка"
                    TextColor="#FFD700"
                    ToolTipProperties.Text="Собрать проект" />

                <Button
                    x:Name="BtnRun"
                    Grid.Column="6"
                    Padding="12,0"
                    Command="{Binding RunCommand}"
                    FontSize="11"
                    HeightRequest="26"
                    Style="{StaticResource AccentButton}"
                    Text="▶ Запустить"
                    ToolTipProperties.Text="Быстрый старт" />
            </Grid>
        </Grid>
    </Border>

</ContentView>
