<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CIDE.PageModels"
             x:DataType="vm:MainPageModel"
             x:Class="CIDE.Views.SplashView">

    <UserControl.Styles>
        <Style Selector="Border.glow">
            <Style.Animations>
                <Animation Duration="0:0:2.5" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="BoxShadow" Value="0 0 15 2 #7C3AED" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="BoxShadow" Value="0 0 50 15 #A78BFA" />
                        <Setter Property="ScaleTransform.ScaleX" Value="1.02" />
                        <Setter Property="ScaleTransform.ScaleY" Value="1.02" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="BoxShadow" Value="0 0 20 4 #7C3AED" />
                        <Setter Property="ScaleTransform.ScaleX" Value="0.97" />
                        <Setter Property="ScaleTransform.ScaleY" Value="0.97" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="StackPanel.entrance">
            <Style.Animations>
                <Animation Duration="0:0:0.8" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.0" />
                        <Setter Property="TranslateTransform.Y" Value="30" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.title">
            <Style.Animations>
                <Animation Duration="0:0:1" Easing="CubicEaseOut" FillMode="Forward" Delay="0:0:0.3">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Background="#1E1E1E">
        <StackPanel Classes="entrance" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
            
            <!-- Logo with glow -->
            <Grid Width="130" Height="130" HorizontalAlignment="Center">
                <Border Classes="glow" CornerRadius="65" Background="#2D2D30" Opacity="0.9">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                </Border>
                <Image Source="avares://CIDE/Assets/cide_logo.png" Width="100" Height="100" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image.RenderTransform>
                        <ScaleTransform />
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <!-- Title -->
            <TextBlock Classes="title" Text="CIDE" 
                       FontSize="48" FontWeight="Bold" Foreground="#CCCCCC" 
                       HorizontalAlignment="Center" LetterSpacing="6" Opacity="0"/>

            <!-- Progress -->
            <ProgressBar IsIndeterminate="True" Margin="0,20,0,0" Width="260" Height="3" 
                         Foreground="#7C3AED" Background="#2D2D30" CornerRadius="2"/>

            <TextBlock Text="{Binding StatusText}" Foreground="#858585" FontSize="12" 
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
